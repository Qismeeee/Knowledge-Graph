ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_default_password
NEO4J_DB=neo4j

# Repository Sync
REPOS_SYNC_INTERVAL_HOURS=24
MAX_CONCURRENT_SYNCS=2
REPO_CLONE_BASE_PATH=/workspace/repos

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# Feature Flags
ENABLE_INCREMENTAL_INDEXING=true
ENABLE_VECTOR_SEARCH=false
ENABLE_WEBHOOKS=true

# Timeouts & Limits
QUERY_TIMEOUT_SECONDS=30
MAX_GRAPH_DEPTH=5
BATCH_SIZE=1000